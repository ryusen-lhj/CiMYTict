@model CiMYTict.Models.Showtime
@{
    ViewData["Title"] = "Edit Showtime";
    var hasBookings = ViewBag.HasBookings is bool value && value;
}

<div class="admin-form-page">
    <div class="admin-form-heading">
        <div>
            <span class="admin-eyebrow">SCHEDULE MANAGEMENT</span>
            <h1>Edit Showtime</h1>
            <p>Update the movie session, cinema hall, date, start time and ticket price.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light"><i class="bi bi-arrow-left me-1"></i>Back to showtimes</a>
    </div>

    @if (hasBookings)
    {
        <div class="alert alert-warning">
            This session already has bookings. To protect existing tickets, its movie, hall and start time are locked. You can still update the ticket price.
        </div>
    }

    <form asp-action="Edit" asp-route-id="@Model.ShowtimeId" method="post" class="admin-form-card">
        <input type="hidden" asp-for="ShowtimeId" />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="MovieId" class="form-label">Movie</label>
                <select asp-for="MovieId" asp-items="ViewBag.Movies" class="form-select" disabled="@hasBookings"></select>
                @if (hasBookings) { <input type="hidden" asp-for="MovieId" /> }
                <span asp-validation-for="MovieId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CinemaHallId" class="form-label">Cinema Hall</label>
                <select asp-for="CinemaHallId" asp-items="ViewBag.Halls" class="form-select" disabled="@hasBookings"></select>
                @if (hasBookings) { <input type="hidden" asp-for="CinemaHallId" /> }
                <span asp-validation-for="CinemaHallId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="StartTime" class="form-label">Date &amp; Start Time</label>
                <input asp-for="StartTime" type="datetime-local" class="form-control" disabled="@hasBookings" />
                @if (hasBookings) { <input type="hidden" asp-for="StartTime" value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" /> }
                <span asp-validation-for="StartTime" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="BaseTicketPrice" class="form-label">Base Ticket Price (RM)</label>
                <input asp-for="BaseTicketPrice" type="number" step="0.50" min="0.01" class="form-control" />
                <span asp-validation-for="BaseTicketPrice" class="text-danger small"></span>
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="btn btn-danger"><i class="bi bi-check2-circle me-1"></i>Save Changes</button>
            <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
