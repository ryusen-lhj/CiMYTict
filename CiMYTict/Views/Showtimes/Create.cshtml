@model CiMYTict.Models.Showtime
@{
    ViewData["Title"] = "Schedule Showtime";
}

<div class="admin-form-page">
    <div class="admin-form-heading">
        <div>
            <span class="admin-eyebrow">CINEMA OPERATIONS</span>
            <h1>Schedule Showtime</h1>
            <p>Create a new movie session. A 20-minute cleaning buffer is included automatically.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light"><i class="bi bi-arrow-left me-1"></i>Back to showtimes</a>
    </div>

    <form asp-action="Create" method="post" class="admin-form-card">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="MovieId" class="form-label">Movie</label>
                <select asp-for="MovieId" asp-items="ViewBag.Movies" class="form-select">
                    <option value="">Choose a movie</option>
                </select>
                <span asp-validation-for="MovieId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CinemaHallId" class="form-label">Cinema Hall</label>
                <select asp-for="CinemaHallId" asp-items="ViewBag.Halls" class="form-select">
                    <option value="">Choose a hall</option>
                </select>
                <span asp-validation-for="CinemaHallId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="StartTime" class="form-label">Date &amp; Start Time</label>
                <input asp-for="StartTime" type="datetime-local" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="BaseTicketPrice" class="form-label">Base Ticket Price (RM)</label>
                <input asp-for="BaseTicketPrice" type="number" step="0.50" min="0.01" class="form-control" />
                <span asp-validation-for="BaseTicketPrice" class="text-danger small"></span>
            </div>
        </div>
        <div class="admin-form-actions">
            <button type="submit" class="btn btn-danger"><i class="bi bi-calendar2-plus me-1"></i>Publish Showtime</button>
            <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
