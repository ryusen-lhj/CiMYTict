@model IEnumerable<CiMYTict.Models.Showtime>
@{
    ViewData["Title"] = "Manage Showtimes";
}

<div class="admin-form-page">
    <div class="admin-form-heading">
        <div>
            <span class="admin-eyebrow">CINEMA OPERATIONS</span>
            <h1>Manage Showtimes</h1>
            <p>Schedule, update and review movie sessions across your cinema halls.</p>
        </div>
        <a asp-action="Create" class="btn btn-danger"><i class="bi bi-plus-lg me-1"></i>Schedule Showtime</a>
    </div>

    <div class="admin-table-card table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Movie</th>
                    <th>Hall</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Base Price</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-semibold">@s.Movie?.Title</td>
                        <td>@s.CinemaHall?.HallName</td>
                        <td>@s.StartTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td>@s.EndTime.ToString("hh:mm tt")</td>
                        <td>RM @s.BaseTicketPrice.ToString("F2")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@s.ShowtimeId" class="btn btn-sm btn-outline-light me-1">
                                <i class="bi bi-pencil-square me-1"></i>Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@s.ShowtimeId" method="post" class="d-inline" onsubmit="return confirm('Delete this showtime?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-5 text-muted">No showtimes have been scheduled yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
