@model CiMYTict.Models.Movie
@{
    ViewData["Title"] = "Add Movie";
}

<h2 class="fw-bold mb-3">Add Movie</h2>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm border-0 col-md-8">
    <partial name="_MovieFields" model="Model" />
    <div>
        <button type="submit" class="btn btn-danger">Save Movie</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
