@model CiMYTict.Models.Promotion
@{
    ViewData["Title"] = "Add Promo";
}

<h2 class="fw-bold mb-3">Add Promo Code</h2>
<form asp-action="Create" method="post" class="card p-4 shadow-sm border-0 col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
    <div class="mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control text-uppercase" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
    <div class="row">
        <div class="col-6 mb-3">
            <label asp-for="DiscountPercentage" class="form-label">Discount (%)</label>
            <input asp-for="DiscountPercentage" type="number" min="1" max="100" class="form-control" />
            <span asp-validation-for="DiscountPercentage" class="text-danger small"></span>
        </div>
        <div class="col-6 mb-3">
            <label asp-for="MaxDiscountAmount" class="form-label">Max Discount (RM)</label>
            <input asp-for="MaxDiscountAmount" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="MaxDiscountAmount" class="text-danger small"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6 mb-3">
            <label asp-for="ValidFrom" class="form-label">Valid From</label>
            <input asp-for="ValidFrom" type="date" class="form-control" />
        </div>
        <div class="col-6 mb-3">
            <label asp-for="ValidUntil" class="form-label">Valid Until</label>
            <input asp-for="ValidUntil" type="date" class="form-control" />
            <span asp-validation-for="ValidUntil" class="text-danger small"></span>
        </div>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Active</label>
    </div>
    <div>
        <button type="submit" class="btn btn-danger">Create Promo</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
