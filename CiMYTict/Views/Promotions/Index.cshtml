@model IEnumerable<CiMYTict.Models.Promotion>
@{
    ViewData["Title"] = "Promotions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">Promo Codes</h2>
    <a asp-action="Create" class="btn btn-danger">Add Promo</a>
</div>

<div class="table-responsive bg-white shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Code</th>
                <th>Description</th>
                <th>Discount</th>
                <th>Max (RM)</th>
                <th>Valid</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><span class="badge bg-dark">@p.Code</span></td>
                    <td>@p.Description</td>
                    <td>@p.DiscountPercentage%</td>
                    <td>@p.MaxDiscountAmount.ToString("F2")</td>
                    <td>@p.ValidFrom.ToString("dd MMM yyyy") - @p.ValidUntil.ToString("dd MMM yyyy")</td>
                    <td>
                        <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">@(p.IsActive ? "Active" : "Disabled")</span>
                    </td>
                    <td class="text-end">
                        <form asp-action="ToggleStatus" asp-route-id="@p.PromotionId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@(p.IsActive ? "Disable" : "Enable")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
