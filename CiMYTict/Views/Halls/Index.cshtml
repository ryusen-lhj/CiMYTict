@model IEnumerable<CiMYTict.Models.CinemaHall>
@using CiMYTict.Models
@{
    ViewData["Title"] = "Manage Halls";
}

<div class="hall-admin-page">
    <div class="admin-form-heading">
        <div>
            <span class="admin-eyebrow">CINEMA MANAGEMENT</span>
            <h1>Auditoriums &amp; Halls</h1>
            <p>Manage capacity, auditorium formats and optional seat categories.</p>
        </div>
        <a asp-action="Create" class="btn btn-danger"><i class="bi bi-plus-lg me-1"></i> Add Hall</a>
    </div>

    <div class="hall-table-wrap table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Hall</th>
                    <th>Format</th>
                    <th>Layout</th>
                    <th>Capacity</th>
                    <th>Standard</th>
                    <th>VIP</th>
                    <th>Couple</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center py-5 text-secondary">No cinema halls have been created yet.</td></tr>
                }
                @foreach (var h in Model)
                {
                    var formatName = h.HallType switch
                    {
                        CinemaHallType.StandardMidSize => "Standard / Mid-size",
                        CinemaHallType.LargeFormatIMAX => "Large format / IMAX",
                        CinemaHallType.SmallIndependent => "Small / Independent",
                        CinemaHallType.VIPRecliner => "VIP / Recliner",
                        CinemaHallType.CouplesThemed => "Couples / Themed",
                        _ => "Standard / Mid-size"
                    };
                    var vipCount = h.Seats.Count(s => s.Category == SeatCategory.VIP);
                    var coupleCount = h.Seats.Count(s => s.Category == SeatCategory.Couple);
                    <tr>
                        <td><strong>@h.HallName</strong></td>
                        <td><span class="hall-type-pill">@formatName</span></td>
                        <td>@h.TotalRows rows × @h.SeatsPerRow</td>
                        <td><strong>@h.Seats.Count</strong> seats</td>
                        <td>@h.Seats.Count(s => s.Category == SeatCategory.Standard)</td>
                        <td>
                            @if (vipCount > 0) { <span>@vipCount</span> }
                            else { <span class="text-secondary">Not offered</span> }
                        </td>
                        <td>
                            @if (coupleCount > 0) { <span>@coupleCount</span> }
                            else { <span class="text-secondary">Not offered</span> }
                        </td>
                        <td><a asp-action="Edit" asp-route-id="@h.CinemaHallId" class="btn btn-sm btn-outline-danger"><i class="bi bi-pencil-square me-1"></i> Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="hall-guideline p-3 mt-3 small">
        <strong><i class="bi bi-info-circle me-1"></i> Auditorium capacity guidelines</strong>
        <p class="mb-0 mt-1">Standard: 120–250 · IMAX: 250–500 · Independent: 50–120 · VIP/Recliner: 40–80 · Couples/Themed: 20–50. VIP and Couple seat categories are optional for every hall; a hall can contain 100% Standard seats.</p>
    </div>
</div>
