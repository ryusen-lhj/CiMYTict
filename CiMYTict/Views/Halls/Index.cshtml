@model IEnumerable<CiMYTict.Models.CinemaHall>
@using CiMYTict.Models
@{
    ViewData["Title"] = "Manage Halls";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-1">Cinema Halls</h2>
        <p class="text-muted mb-0">Manage auditorium capacity, formats and individual seat categories.</p>
    </div>
    <a asp-action="Create" class="btn btn-danger">Add Hall</a>
</div>

<div class="table-responsive bg-white shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Hall</th><th>Auditorium Type</th><th>Rows</th><th>Seats / Row</th>
                <th>Capacity</th><th>Standard</th><th>VIP</th><th>Couple</th><th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model)
            {
                <tr>
                    <td class="fw-semibold">@h.HallName</td>
                    <td>@h.HallType.ToString()</td>
                    <td>@h.TotalRows</td>
                    <td>@h.SeatsPerRow</td>
                    <td>@h.Seats.Count</td>
                    <td>@h.Seats.Count(s => s.Category == SeatCategory.Standard)</td>
                    <td>@h.Seats.Count(s => s.Category == SeatCategory.VIP)</td>
                    <td>@h.Seats.Count(s => s.Category == SeatCategory.Couple)</td>
                    <td><a asp-action="Edit" asp-route-id="@h.CinemaHallId" class="btn btn-sm btn-outline-danger">Edit Hall</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="small text-muted mt-3">
    Capacity guidelines: Standard 120–250 · IMAX 250–500 · Independent 50–120 · VIP/Recliner 40–80 · Couples/Themed 20–50.
</div>
