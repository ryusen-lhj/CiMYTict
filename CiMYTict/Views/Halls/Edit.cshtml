@model CiMYTict.Models.CinemaHall
@using CiMYTict.Models
@{
    ViewData["Title"] = "Edit Hall";
    var seats = Model.Seats.OrderBy(s => s.RowLabel).ThenBy(s => s.SeatNumber).ToList();
    bool hasBookings = ViewBag.HasBookings is bool value && value;
}

<div class="hall-admin-page">
    <div class="admin-form-heading">
        <div>
            <span class="admin-eyebrow">AUDITORIUM CONFIGURATION</span>
            <h1>Edit @Model.HallName</h1>
            <p>Adjust your hall layout and assign categories to individual seats.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light"><i class="bi bi-arrow-left me-1"></i> Back to Halls</a>
    </div>

    @if (hasBookings)
    {
        <div class="alert alert-warning"><i class="bi bi-lock-fill me-1"></i> This hall has booking records. Its layout, format, seat categories and surcharges are locked to protect existing tickets. You may still rename the hall.</div>
    }

    <form asp-action="Edit" asp-route-id="@Model.CinemaHallId" method="post" class="hall-admin-card p-3 p-md-4">
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label" for="hallName">Hall Name</label>
                <input class="form-control" id="hallName" name="hallName" value="@Model.HallName" maxlength="50" required />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="hallType">Auditorium Format</label>
                <select class="form-select" id="hallType" name="hallType" @(hasBookings ? "disabled" : "")>
                    <option value="0" selected="@(Model.HallType == CinemaHallType.StandardMidSize)">Standard / Mid-size (120–250)</option>
                    <option value="1" selected="@(Model.HallType == CinemaHallType.LargeFormatIMAX)">Large format / IMAX (250–500)</option>
                    <option value="2" selected="@(Model.HallType == CinemaHallType.SmallIndependent)">Small / Independent (50–120)</option>
                    <option value="3" selected="@(Model.HallType == CinemaHallType.VIPRecliner)">VIP / Recliner auditorium (40–80)</option>
                    <option value="4" selected="@(Model.HallType == CinemaHallType.CouplesThemed)">Couples / Themed suites (20–50)</option>
                </select>
                @if (hasBookings)
                {
                    <input type="hidden" name="hallType" value="@((int)Model.HallType)" />
                }
                <div class="hall-optional-note mt-2">Auditorium format does not force every seat to be VIP or Couple.</div>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="totalRows">Rows</label>
                <input class="form-control" id="totalRows" name="totalRows" type="number" min="1" max="26" value="@Model.TotalRows" @(hasBookings ? "readonly" : "") />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="seatsPerRow">Seats / Row</label>
                <input class="form-control" id="seatsPerRow" name="seatsPerRow" type="number" min="1" max="30" value="@Model.SeatsPerRow" @(hasBookings ? "readonly" : "") />
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <strong class="me-2">Seat categories</strong>
            <span class="badge bg-primary">Standard</span>
            <span class="badge bg-warning text-dark">VIP (optional)</span>
            <span class="badge bg-danger">Couple (optional)</span>
            <span class="hall-optional-note ms-md-auto">Total: @seats.Count seats · No VIP seats are required</span>
        </div>
        <div class="hall-screen-label">SCREEN</div>
        <div class="hall-seat-map mb-4">
            @foreach (var row in seats.GroupBy(s => s.RowLabel).OrderBy(g => g.Key))
            {
                <div class="hall-seat-row">
                    <span class="hall-seat-row-label">@row.Key</span>
                    @foreach (var seat in row)
                    {
                        <div class="hall-seat-cell">
                            <small>@seat.SeatCode</small>
                            <input type="hidden" name="seatIds" value="@seat.SeatId" />
                            <select name="seatCategories" class="form-select form-select-sm mb-1" aria-label="Category for @seat.SeatCode" @(hasBookings ? "disabled" : "")>
                                <option value="0" selected="@(seat.Category == SeatCategory.Standard)">Standard</option>
                                <option value="1" selected="@(seat.Category == SeatCategory.VIP)">VIP</option>
                                <option value="2" selected="@(seat.Category == SeatCategory.Couple)">Couple</option>
                            </select>
                            @if (hasBookings)
                            {
                                <input type="hidden" name="seatCategories" value="@((int)seat.Category)" />
                            }
                            <input name="extraPrices" type="number" min="0" max="500" step="0.50"
                                   value="@seat.ExtraPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control form-control-sm" aria-label="Extra price for @seat.SeatCode" @(hasBookings ? "readonly" : "") />
                        </div>
                    }
                </div>
            }
        </div>

        <div class="hall-guideline p-3 small mb-3">
            <strong><i class="bi bi-lightbulb me-1"></i> Flexible seat setup</strong>
            <p class="mb-0 mt-1">Keep all seats as Standard if this hall does not offer VIP or Couple seating. Select a category only for the individual seats that provide that experience. Surcharges are optional and can be left at RM0.00.</p>
        </div>
        <div class="admin-form-actions">
            <button type="submit" class="btn btn-danger"><i class="bi bi-check2-circle me-1"></i> Save Hall Changes</button>
            <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
        </div>
    </form>
</div>
