@model CiMYTict.Models.CinemaHall
@using CiMYTict.Models
@{
    ViewData["Title"] = "Add Hall";
}

<h2 class="fw-bold mb-2">Add Cinema Hall</h2>
<p class="text-muted">Choose an auditorium format. All seats start as Standard; you can assign VIP or Couple seats individually on the next screen.</p>
<form asp-action="Create" method="post" class="card p-4 shadow-sm border-0 col-lg-7">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
    <div class="mb-3">
        <label asp-for="HallName" class="form-label">Hall Name</label>
        <input asp-for="HallName" class="form-control" placeholder="e.g. Hall 1 - IMAX" />
        <span asp-validation-for="HallName" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="HallType" class="form-label">Auditorium Type</label>
        <select asp-for="HallType" class="form-select">
            <option value="0">Standard / Mid-size (120–250 seats)</option>
            <option value="1">Large format / IMAX (250–500 seats)</option>
            <option value="2">Small / Independent (50–120 seats)</option>
            <option value="3">VIP / Recliner (40–80 seats)</option>
            <option value="4">Couples / Themed suites (20–50 seats)</option>
        </select>
    </div>
    <div class="row">
        <div class="col-6 mb-3">
            <label asp-for="TotalRows" class="form-label">Rows (1–26)</label>
            <input asp-for="TotalRows" type="number" min="1" max="26" class="form-control" />
            <span asp-validation-for="TotalRows" class="text-danger small"></span>
        </div>
        <div class="col-6 mb-3">
            <label asp-for="SeatsPerRow" class="form-label">Seats per Row</label>
            <input asp-for="SeatsPerRow" type="number" min="1" max="30" class="form-control" />
            <span asp-validation-for="SeatsPerRow" class="text-danger small"></span>
        </div>
    </div>
    <div class="alert alert-info small">Recommended: around 200 seats for a standard auditorium. For example, 20 rows × 10 seats = 200 seats.</div>
    <div>
        <button type="submit" class="btn btn-danger">Create Hall &amp; Configure Seats</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
