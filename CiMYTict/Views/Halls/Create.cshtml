@model CiMYTict.Models.CinemaHall
@using CiMYTict.Models
@{
    ViewData["Title"] = "Add Hall";
}

<div class="hall-admin-page">
    <div class="admin-form-heading">
        <div>
            <span class="admin-eyebrow">AUDITORIUM SETUP</span>
            <h1>Add Cinema Hall</h1>
            <p>Create the auditorium first, then optionally customize individual seats.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light"><i class="bi bi-arrow-left me-1"></i> Back to Halls</a>
    </div>

    <form asp-action="Create" method="post" class="hall-admin-card p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <div class="row g-3">
            <div class="col-lg-6">
                <label asp-for="HallName" class="form-label">Hall Name</label>
                <input asp-for="HallName" class="form-control" placeholder="e.g. Hall 1" />
                <span asp-validation-for="HallName" class="text-danger small"></span>
            </div>
            <div class="col-lg-6">
                <label asp-for="HallType" class="form-label">Auditorium Format</label>
                <select asp-for="HallType" class="form-select">
                    <option value="0">Standard / Mid-size (120–250 seats)</option>
                    <option value="1">Large format / IMAX (250–500 seats)</option>
                    <option value="2">Small / Independent (50–120 seats)</option>
                    <option value="3">VIP / Recliner auditorium (40–80 seats)</option>
                    <option value="4">Couples / Themed suites (20–50 seats)</option>
                </select>
                <div class="hall-optional-note mt-2">This describes the auditorium format. It does not require VIP or Couple seats.</div>
            </div>
            <div class="col-md-6">
                <label asp-for="TotalRows" class="form-label">Number of Rows (1–26)</label>
                <input asp-for="TotalRows" type="number" min="1" max="26" class="form-control" />
                <span asp-validation-for="TotalRows" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SeatsPerRow" class="form-label">Seats per Row (1–30)</label>
                <input asp-for="SeatsPerRow" type="number" min="1" max="30" class="form-control" />
                <span asp-validation-for="SeatsPerRow" class="text-danger small"></span>
            </div>
        </div>
        <div class="hall-guideline p-3 mt-4 small">
            <strong><i class="bi bi-info-circle me-1"></i> Capacity guideline</strong>
            <p class="mb-0 mt-1">Standard: 120–250 · IMAX: 250–500 · Independent: 50–120 · VIP/Recliner: 40–80 · Couples/Themed: 20–50. A standard auditorium commonly targets around 200 seats (20 rows × 10 seats).
        </div>
        <div class="hall-guideline p-3 mt-3 small">
            <strong><i class="bi bi-check2-circle me-1"></i> Seat categories are optional</strong>
            <p class="mb-0 mt-1">New halls start with all Standard seats. You can leave every seat Standard, or select VIP and Couple for only the seats you want on the next screen. There is no minimum VIP-seat requirement.</p>
        </div>
        <div class="admin-form-actions">
            <button type="submit" class="btn btn-danger"><i class="bi bi-plus-circle me-1"></i> Create Hall &amp; Configure Seats</button>
            <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
