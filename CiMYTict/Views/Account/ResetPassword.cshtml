@model CiMYTict.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Verify and Reset Password";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <h3 class="fw-bold text-center">Verify Your Email</h3>
                <p class="text-muted text-center">Enter the 6-digit code sent to your email, then choose a new password. Code expires in 10 minutes.</p>
                <form asp-action="ResetPassword" method="post">
                    <input asp-for="Email" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="VerificationCode" class="form-label"></label>
                        <input asp-for="VerificationCode" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" />
                        <span asp-validation-for="VerificationCode" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-danger w-100">Verify Code & Reset Password</button>
                </form>
                <a asp-action="ForgotPassword" class="d-block text-center mt-3">Request a new code</a>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
