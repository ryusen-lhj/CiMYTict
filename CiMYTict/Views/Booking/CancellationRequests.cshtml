@model IEnumerable<CiMYTict.Models.Booking>
@{
    ViewData["Title"] = "Cancellation Requests";
}
<div class="admin-form-page">
    <div class="admin-form-heading">
        <div>
            <span class="admin-eyebrow">CUSTOMER SERVICE</span>
            <h1>Cancellation Requests</h1>
            <p>Review the customer's reason before approving or rejecting a ticket cancellation.</p>
        </div>
        <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-outline-light">Back to Dashboard</a>
    </div>
    @if (!Model.Any())
    {
        <div class="admin-table-card p-4 text-center">There are no pending cancellation requests.</div>
    }
    else
    {
        <div class="row g-3">
        @foreach (var booking in Model)
        {
            <div class="col-12">
                <div class="admin-form-card">
                    <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                        <div>
                            <span class="badge bg-warning text-dark">Awaiting Review</span>
                            <h5 class="mt-2 mb-1">@booking.BookingReference — @booking.Showtime?.Movie?.Title</h5>
                            <div class="small text-muted">Requested @booking.CancellationRequestedAt?.ToString("dd MMM yyyy, hh:mm tt")</div>
                        </div>
                        <div class="text-md-end">
                            <div class="fw-bold">RM @booking.TotalAmount.ToString("F2")</div>
                            <div class="small text-muted">Payment / refund review</div>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="small text-muted">Customer</div>
                            <strong>@booking.User?.FullName</strong>
                            <div class="small">@booking.User?.Email</div>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">Showtime</div>
                            <strong>@booking.Showtime?.StartTime.ToString("ddd, dd MMM yyyy, hh:mm tt")</strong>
                            <div class="small">@booking.Showtime?.CinemaHall?.HallName</div>
                        </div>
                        <div class="col-12">
                            <div class="small text-muted">Seats</div>
                            <strong>@string.Join(", ", booking.BookingSeats.Select(s => s.Seat?.SeatCode))</strong>
                        </div>
                        <div class="col-12">
                            <div class="small text-muted mb-1">Customer's reason</div>
                            <div class="rounded p-3" style="background:rgba(255,255,255,.05);white-space:pre-wrap;">@booking.CancellationReason</div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <form asp-action="ReviewCancellation" method="post" class="d-inline" onsubmit="return confirm('Approve cancellation for @booking.BookingReference? The ticket will be cancelled and payment marked refunded.');">
                            <input type="hidden" name="bookingId" value="@booking.BookingId" />
                            <input type="hidden" name="decision" value="Approve" />
                            <button type="submit" class="btn btn-danger"><i class="bi bi-check-circle me-1"></i>Approve Cancellation</button>
                        </form>
                        <form asp-action="ReviewCancellation" method="post" class="d-inline" onsubmit="return confirm('Reject this cancellation request? The ticket will remain confirmed.');">
                            <input type="hidden" name="bookingId" value="@booking.BookingId" />
                            <input type="hidden" name="decision" value="Reject" />
                            <button type="submit" class="btn btn-outline-light"><i class="bi bi-x-circle me-1"></i>Reject Request</button>
                        </form>
                    </div>
                </div>
            </div>
        }
        </div>
    }
</div>
