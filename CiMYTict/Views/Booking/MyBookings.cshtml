@model IEnumerable<CiMYTict.Models.Booking>
@using CiMYTict.Models
@{
    ViewData["Title"] = "My Bookings";
}
<h2 class="fw-bold mb-3">My Ticket Bookings</h2>
@if (!Model.Any())
{
    <div class="alert alert-info">You haven't booked any tickets yet. <a asp-controller="Home" asp-action="Index">Browse movies now!</a></div>
}
else
{
    <div class="row g-3">
    @foreach (var b in Model)
    {
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-dark">@b.BookingReference</span>
                        <span class="badge @(b.Status == BookingStatus.Confirmed ? "bg-success" : b.Status == BookingStatus.CancellationRequested ? "bg-warning text-dark" : "bg-secondary")">@b.Status</span>
                    </div>
                    <h5 class="fw-bold mb-1">@b.Showtime?.Movie?.Title</h5>
                    <p class="small text-muted mb-2">@b.Showtime?.CinemaHall?.HallName &bull; @b.Showtime?.StartTime.ToString("dd MMM yyyy, hh:mm tt")</p>
                    <div class="small mb-2">
                        <strong>Seats:</strong> @string.Join(", ", b.BookingSeats.Select(bs => bs.Seat?.SeatCode))<br />
                        <strong>Paid:</strong> RM @b.TotalAmount.ToString("F2") (Saved RM @b.DiscountAmount.ToString("F2"))
                    </div>
                    @if (b.Status == BookingStatus.CancellationRequested)
                    {
                        <div class="alert alert-warning small mt-3 mb-0">
                            <strong>Cancellation under review.</strong> Your ticket remains active until the admin approves the request.
                            <div class="mt-1">Reason: @b.CancellationReason</div>
                        </div>
                    }
                    else if (b.Status == BookingStatus.Cancelled)
                    {
                        <div class="alert alert-secondary small mt-3 mb-0">
                            <strong>Ticket cancelled.</strong> Cancellation decision: @(b.CancellationDecision ?? "Approved"). Payment status: @b.Payment?.Status.
                        </div>
                    }
                    else if (b.Status == BookingStatus.Confirmed)
                    {
                        <div class="d-flex gap-2 mt-3 flex-wrap">
                            <a asp-action="Ticket" asp-route-bookingId="@b.BookingId" class="btn btn-danger btn-sm">View E-Ticket</a>
                            @if (b.Showtime!.StartTime > CiMYTict.Services.CinemaClock.Now.AddHours(2))
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#cancelModal-@b.BookingId">Request Cancellation</button>
                            }
                        </div>
                        @if (b.Showtime!.StartTime > CiMYTict.Services.CinemaClock.Now.AddHours(2))
                        {
                            <div class="modal fade" id="cancelModal-@b.BookingId" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content text-dark">
                                        <form asp-action="CancelBooking" method="post">
                                            <div class="modal-header"><h5 class="modal-title">Request Ticket Cancellation</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                                            <div class="modal-body">
                                                <p class="small text-muted">Tell us why you need to cancel this booking. The admin will review your request before the ticket is cancelled.</p>
                                                <input type="hidden" name="bookingId" value="@b.BookingId" />
                                                <label class="form-label" for="reason-@b.BookingId">Reason for cancellation</label>
                                                <textarea id="reason-@b.BookingId" name="reason" class="form-control" rows="4" maxlength="500" required placeholder="Please explain why you need to cancel or request a refund."></textarea>
                                            </div>
                                            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Go Back</button><button type="submit" class="btn btn-danger">Submit Request</button></div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
    </div>
}