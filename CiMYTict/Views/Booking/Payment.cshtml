@model CiMYTict.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Secure Payment";
    var banks = new[] { "Maybank", "CIMB Bank", "Public Bank", "RHB Bank", "Hong Leong Bank", "AmBank", "Alliance Bank", "Affin Bank" };
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="payment-page card border-0 shadow-lg">
            <div class="payment-header p-4 text-center text-white">
                <div class="payment-lock mb-2"><i class="bi bi-shield-lock-fill"></i></div>
                <div class="small text-uppercase fw-bold opacity-75">CiMYTict checkout</div>
                <h2 class="fw-bold mb-1">Complete Your Payment</h2>
                <p class="mb-0 opacity-75">Choose your payment method below</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <div class="alert alert-warning small">
                    <strong>Demo payment only.</strong> This project does not yet connect to Touch ’n Go, FPX or a card payment gateway. Do not enter real card details. Confirmation below simulates payment and generates an e-ticket.
                </div>
                <h5 class="fw-bold mb-3">Order summary</h5>
                <div class="payment-summary rounded-3 p-3 mb-4">
                    <div class="d-flex justify-content-between gap-3 mb-2"><span class="text-muted">Movie</span><strong class="text-end">@Model.Booking.Showtime?.Movie?.Title</strong></div>
                    <div class="d-flex justify-content-between gap-3 mb-2"><span class="text-muted">Cinema hall</span><strong>@Model.Booking.Showtime?.CinemaHall?.HallName</strong></div>
                    <div class="d-flex justify-content-between gap-3 mb-2"><span class="text-muted">Showtime</span><strong class="text-end">@Model.Booking.Showtime?.StartTime.ToString("dd MMM yyyy, hh:mm tt")</strong></div>
                    <div class="d-flex justify-content-between gap-3"><span class="text-muted">Seats</span><strong class="text-end">@string.Join(", ", Model.Booking.BookingSeats.Select(x => x.Seat?.SeatCode))</strong></div>
                </div>
                <div class="payment-summary rounded-3 p-3 mb-4">
                    <div class="d-flex justify-content-between mb-2"><span>Subtotal</span><span>RM @Model.Booking.SubTotal.ToString("F2")</span></div>
                    <div class="d-flex justify-content-between mb-2"><span>Promo discount</span><span>− RM @Model.PromoDiscount.ToString("F2")</span></div>
                    <div class="d-flex justify-content-between mb-2"><span>Reward points (@Model.PointsToRedeem pts)</span><span>− RM @Model.PointsDiscount.ToString("F2")</span></div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center"><strong class="fs-5">Amount to pay</strong><strong class="fs-3 text-danger">RM @Model.TotalAmount.ToString("F2")</strong></div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Selected payment method</label>
                    <div class="form-control bg-light">@Model.PaymentMethod</div>
                </div>

                @if (Model.PaymentMethod == "Touch 'n Go eWallet")
                {
                    <div class="border rounded-3 p-4 text-center mb-4">
                        <h5 class="fw-bold">Scan with Touch ’n Go eWallet</h5>
                        <p class="small text-muted">Scan this Malaysia National QR (DuitNow QR) using a supported banking or eWallet app.</p>
                        <img src="/hj.jpeg" alt="Touch 'n Go eWallet payment QR code" class="img-fluid border rounded-3 p-2 mb-3" style="max-width:280px;" />
                        <div class="small text-muted">Merchant: LIMHONGJUN</div>
                        <div class="alert alert-info small text-start mt-3 mb-0">This static QR does not send payment status back to CiMYTict. In this demo, click the confirmation button only after completing the transfer. A real deployment needs gateway verification or a dynamic merchant QR.</div>
                    </div>
                }
                else if (Model.PaymentMethod == "FPX Online Banking")
                {
                    <div class="border rounded-3 p-4 mb-4">
                        <h5 class="fw-bold mb-3">Select your bank</h5>
                        <select id="bankName" name="bankName" form="confirmPaymentForm" class="form-select" required>
                            <option value="">Choose a bank</option>
                            @foreach (var bank in banks)
                            {
                                <option value="@bank">@bank</option>
                            }
                        </select>
                        <div class="form-text">FPX redirection is simulated in this project. No bank login details are requested.</div>
                    </div>
                }
                else if (Model.PaymentMethod == "Credit / Debit Card")
                {
                    <div class="border rounded-3 p-4 mb-4">
                        <h5 class="fw-bold mb-3">Card details (demo validation only)</h5>
                        <div class="alert alert-info small">Use test values only. Card fields stay in your browser and are not sent to the CiMYTict server.</div>
                        <div class="mb-3">
                            <label for="cardNumber" class="form-label">Card number</label>
                            <input id="cardNumber" class="form-control" inputmode="numeric" autocomplete="off" maxlength="19" placeholder="1234 5678 9012 3456" />
                            <div class="invalid-feedback">Enter a 16-digit card number.</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <label for="expiry" class="form-label">Expiry date (MM/YY)</label>
                                <input id="expiry" class="form-control" inputmode="numeric" maxlength="5" placeholder="MM/YY" autocomplete="off" />
                                <div class="invalid-feedback">Enter a valid, non-expired MM/YY date.</div>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label for="cvv" class="form-label">CVV</label>
                                <input id="cvv" class="form-control" inputmode="numeric" maxlength="3" placeholder="123" autocomplete="off" />
                                <div class="invalid-feedback">Enter a 3-digit CVV.</div>
                            </div>
                        </div>
                    </div>
                }

                <form asp-action="ConfirmPayment" method="post" id="confirmPaymentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookingId" value="@Model.Booking.BookingId" />
                    <input type="hidden" name="promoCode" value="@Model.PromoCode" />
                    <input type="hidden" name="redeemPoints" value="@Model.RedeemPoints.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="paymentMethod" value="@Model.PaymentMethod" />
                    <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold" id="payButton">
                        <i class="bi bi-shield-check me-2"></i>Pay RM @Model.TotalAmount.ToString("F2")
                    </button>
                </form>
                <a asp-action="Checkout" asp-route-bookingId="@Model.Booking.BookingId" class="btn btn-link text-secondary w-100 mt-2">Back to checkout</a>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script>
(() => {
    const form = document.getElementById('confirmPaymentForm');
    const method = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentMethod));
    const digits = value => value.replace(/\D/g, '');
    if (method === 'Credit / Debit Card') {
        form.addEventListener('submit', event => {
            const number = digits(document.getElementById('cardNumber').value);
            const expiry = document.getElementById('expiry').value.trim();
            const cvv = digits(document.getElementById('cvv').value);
            const match = /^(0[1-9]|1[0-2])\/(\d{2})$/.exec(expiry);
            let validExpiry = false;
            if (match) {
                const month = Number(match[1]);
                const year = 2000 + Number(match[2]);
                const now = new Date();
                validExpiry = new Date(year, month, 1) > new Date(now.getFullYear(), now.getMonth(), 1);
            }
            let valid = true;
            for (const [id, ok] of [
                ['cardNumber', number.length === 16],
                ['expiry', validExpiry],
                ['cvv', cvv.length === 3]
            ]) {
                const field = document.getElementById(id);
                field.classList.toggle('is-invalid', !ok);
                valid = valid && ok;
            }
            if (!valid) event.preventDefault();
        });
    }
    const card = document.getElementById('cardNumber');
    card?.addEventListener('input', () => {
        const d = digits(card.value).slice(0, 16);
        card.value = d.replace(/(\d{4})(?=\d)/g, '$1 ').trim();
        card.classList.remove('is-invalid');
    });
    document.getElementById('expiry')?.addEventListener('input', event => {
        let d = digits(event.target.value).slice(0, 4);
        if (d.length > 2) d = d.slice(0, 2) + '/' + d.slice(2);
        event.target.value = d;
        event.target.classList.remove('is-invalid');
    });
    document.getElementById('cvv')?.addEventListener('input', event => {
        event.target.value = digits(event.target.value).slice(0, 3);
        event.target.classList.remove('is-invalid');
    });
})();
</script>
}