<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CiMYTict</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CiMYTict.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark cinema-navbar">
            <div class="container">
                <a class="navbar-brand cinema-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-camera-reels-fill"></i></span>
                    <span>CiMY<span class="brand-accent">Tict</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-film me-1"></i>Movies</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="MyBookings"><i class="bi bi-ticket-perforated me-1"></i>My Bookings</a></li>
                        }
                        @if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-grid me-1"></i>Admin</a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item" asp-controller="AdminDashboard" asp-action="Index">Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Movies" asp-action="Index">Movies</a></li>
                                    <li><a class="dropdown-item" asp-controller="Showtimes" asp-action="Index">Showtimes</a></li>
                                    <li><a class="dropdown-item" asp-controller="Booking" asp-action="CancellationRequests">Cancellation Requests</a></li>
                                    <li><a class="dropdown-item" asp-controller="Halls" asp-action="Index">Halls</a></li>
                                    <li><a class="dropdown-item" asp-controller="Promotions" asp-action="Index">Promotions</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link account-link d-flex align-items-center gap-2" asp-controller="Account" asp-action="Profile">@if (User.FindFirst("ProfileImagePath")?.Value is string avatar && !string.IsNullOrWhiteSpace(avatar)) { <img src="@avatar" alt="" class="profile-avatar-nav" /> } else { <i class="bi bi-person-circle"></i> }<span>@User.Identity.Name</span></a></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm nav-logout">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                            <li class="nav-item"><a class="btn btn-cinema-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Get Started</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container page-container">
        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">@ok<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">@err<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
        }
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="cinema-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span><strong>CiMYTict</strong> <span class="footer-muted">— Your next favourite movie starts here.</span></span>
            <span class="footer-muted">&copy; 2026 CiMYTict. All rights reserved.</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>