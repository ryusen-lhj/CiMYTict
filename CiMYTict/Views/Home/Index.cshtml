@* Views/Home/Index.cshtml *@
@model IEnumerable<CiMYTict.Models.Movie>
@{
    ViewData["Title"] = "Now Showing";
}

<section class="cinema-hero">
    <div class="hero-kicker"><i class="bi bi-stars"></i> Your movie night starts here</div>
    <h1 class="display-5 fw-bold mb-3">Experience cinema <span>redefined.</span></h1>
    <p class="lead mb-4">Discover the latest releases, find your perfect seats, and enjoy a seamless movie experience with CiMYTict.</p>
    <form method="get" class="row g-2 movie-search">
        <div class="col-md-6">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search movie titles..." aria-label="Search movie titles" />
        </div>
        <div class="col-md-4">
            <select name="genre" class="form-select" aria-label="Filter by genre">
                <option value="">All Genres</option>
                @foreach (var g in (List<string>)ViewBag.Genres)
                {
                    <option value="@g" selected="@(ViewBag.Genre == g)">@g</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-danger"><i class="bi bi-search me-1"></i> Explore</button>
        </div>
    </form>
</section>

<div class="section-heading">
    <div>
        <h2>Now Showing</h2>
        <p>Find your next favourite on the big screen.</p>
    </div>
    <span class="text-secondary small"><i class="bi bi-film me-1"></i>Latest movies</span>
</div>
<div class="row g-4">
    @foreach (var movie in Model)
    {
        <div class="col-sm-6 col-md-4 col-lg-3">
            <article class="card movie-card">
                <img src="@(movie.PosterUrl ?? "https://placehold.co/400x600?text=CiMYTict")"
                     class="card-img-top movie-poster" alt="@movie.Title" />
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h5 class="card-title fw-bold mb-0">@movie.Title</h5>
                        <span class="badge">@movie.AgeRating</span>
                    </div>
                    <p class="text-muted small mb-2">@movie.Genre <span class="mx-1">·</span> @movie.DurationMinutes mins</p>
                    <p class="card-text small text-secondary flex-grow-1">
                        @(movie.Description.Length > 90 ? movie.Description.Substring(0, 90) + "..." : movie.Description)
                    </p>
                    <a asp-action="MovieDetails" asp-route-id="@movie.MovieId" class="btn btn-danger w-100 mt-2 fw-semibold">
                        <i class="bi bi-ticket-perforated me-1"></i>Book Tickets
                    </a>
                </div>
            </article>
        </div>
    }
</div>