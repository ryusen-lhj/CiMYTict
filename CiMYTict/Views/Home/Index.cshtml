@model IEnumerable<CiMYTict.Models.Movie>
@{
    ViewData["Title"] = "Now Showing";
    var movies = Model.ToList();
}

<section class="home-showcase">
    <div class="showcase-topline">
        <span class="showcase-kicker"><i class="bi bi-stars"></i> THE BIG SCREEN EXPERIENCE</span>
        <span class="showcase-live"><span></span> NOW SHOWING</span>
    </div>

    @if (movies.Any())
    {
        <div id="nowShowingCarousel" class="carousel slide cinema-carousel" data-bs-ride="carousel" data-bs-interval="5500" data-bs-wrap="true" data-bs-pause="false">
            @if (movies.Count > 1)
            {
                <div class="carousel-indicators">
                    @for (var i = 0; i < movies.Count; i++)
                    {
                        <button type="button" data-bs-target="#nowShowingCarousel" data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")"
                                aria-label="Go to movie @(i + 1)"></button>
                    }
                </div>
            }
            <div class="carousel-inner">
                @for (var i = 0; i < movies.Count; i++)
                {
                    var movie = movies[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="showcase-slide">
                            <div class="showcase-copy">
                                <span class="showcase-overline">FEATURED MOVIE @(i + 1).ToString("00")</span>
                                <h1>@movie.Title</h1>
                                <div class="showcase-meta">
                                    <span><i class="bi bi-film"></i> @movie.Genre</span>
                                    <span><i class="bi bi-clock"></i> @movie.DurationMinutes min</span>
                                    @if (!string.IsNullOrWhiteSpace(movie.AgeRating))
                                    {
                                        <span class="age-rating">@movie.AgeRating</span>
                                    }
                                </div>
                                <p>@(string.IsNullOrWhiteSpace(movie.Description) ? "Discover this movie on the big screen. Choose a showtime and book your seats today." : movie.Description)</p>
                                <a asp-action="MovieDetails" asp-route-id="@movie.MovieId" class="btn btn-cinema-primary showcase-book">
                                    <i class="bi bi-ticket-perforated-fill me-2"></i>Book Tickets
                                    <i class="bi bi-arrow-right ms-2"></i>
                                </a>
                            </div>
                            <div class="showcase-art">
                                <div class="poster-glow"></div>
                                <img src="@(string.IsNullOrWhiteSpace(movie.PosterUrl) ? "https://placehold.co/520x760/182234/f5f7fb?text=CiMYTict" : movie.PosterUrl)"
                                     alt="Movie poster for @movie.Title" />
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (movies.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#nowShowingCarousel" data-bs-slide="prev" aria-label="Previous movie">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#nowShowingCarousel" data-bs-slide="next" aria-label="Next movie">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            }
        </div>
        <div class="showcase-footnote"><i class="bi bi-arrow-repeat me-1"></i> Sit back — the movie lineup rotates automatically.</div>
    }
    else
    {
        <div class="showcase-empty">
            <i class="bi bi-camera-reels"></i>
            <h2>No movies showing right now</h2>
            <p>There are currently no active movies with upcoming showtimes. Please check back soon.</p>
        </div>
    }
</section>

<section class="movie-section">
    <div class="section-heading">
        <div>
            <span class="section-eyebrow">YOUR NEXT MOVIE NIGHT</span>
            <h2>Now Showing</h2>
            <p>Explore every movie with upcoming sessions.</p>
        </div>
        <span class="movie-count"><i class="bi bi-film me-1"></i>@movies.Count movies</span>
    </div>
    @if (movies.Any())
    {
        <div class="row g-4">
            @foreach (var movie in movies)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <article class="card movie-card">
                        <div class="movie-poster-wrap">
                            <img src="@(string.IsNullOrWhiteSpace(movie.PosterUrl) ? "https://placehold.co/400x600/182234/f5f7fb?text=CiMYTict" : movie.PosterUrl)"
                                 class="card-img-top movie-poster" alt="Movie poster for @movie.Title" loading="lazy" />
                            <span class="poster-overlay"><i class="bi bi-play-circle-fill"></i> View movie</span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <h3 class="card-title fw-bold mb-0">@movie.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(movie.AgeRating))
                                {
                                    <span class="badge">@movie.AgeRating</span>
                                }
                            </div>
                            <p class="movie-card-meta">@movie.Genre <span>·</span> @movie.DurationMinutes min</p>
                            <a asp-action="MovieDetails" asp-route-id="@movie.MovieId" class="btn btn-danger w-100 mt-auto fw-semibold">
                                View Showtimes <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>