@* Views/Home/Index.cshtml *@
@model IEnumerable<CiMYTict.Models.Movie>
@{
    ViewData["Title"] = "Now Showing";
}

<div class="bg-dark text-white rounded-3 p-4 p-md-5 mb-4 shadow">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="display-5 fw-bold text-danger">Experience Cinema Redefined</h1>
            <p class="lead mb-3">Book Standard, VIP, or Couple seats instantly at CiMYTict with digital QR E-Tickets.</p>
            <form method="get" class="row g-2">
                <div class="col-sm-6">
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search movie title..." />
                </div>
                <div class="col-sm-4">
                    <select name="genre" class="form-select">
                        <option value="">All Genres</option>
                        @foreach (var g in (List<string>)ViewBag.Genres)
                        {
                            <option value="@g" selected="@(ViewBag.Genre == g)">@g</option>
                        }
                    </select>
                </div>
                <div class="col-sm-2 d-grid">
                    <button type="submit" class="btn btn-danger">Filter</button>
                </div>
            </form>
        </div>
    </div>
</div>

<h3 class="fw-bold mb-3">Now Showing</h3>
<div class="row g-4">
    @foreach (var movie in Model)
    {
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm border-0">
                <img src="@(movie.PosterUrl ?? "https://placehold.co/400x600?text=CiMYTict")"
                     class="card-img-top" alt="@movie.Title" style="height: 340px; object-fit: cover;" />
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h5 class="card-title fw-bold mb-0">@movie.Title</h5>
                        <span class="badge bg-dark">@movie.AgeRating</span>
                    </div>
                    <p class="text-muted small mb-2">@movie.Genre &bull; @movie.DurationMinutes mins</p>
                    <p class="card-text small text-secondary flex-grow-1">
                        @(movie.Description.Length > 90 ? movie.Description.Substring(0, 90) + "..." : movie.Description)
                    </p>
                    <a asp-action="MovieDetails" asp-route-id="@movie.MovieId" class="btn btn-danger w-100 mt-2 fw-semibold">
                        <i class="bi bi-ticket-perforated me-1"></i>Book Tickets
                    </a>
                </div>
            </div>
        </div>
    }
</div>