@* Views/Home/MovieDetails.cshtml *@
@model CiMYTict.Models.Movie
@{
    ViewData["Title"] = Model.Title;
}

<div class="row g-4 bg-white p-4 rounded shadow-sm">
    <div class="col-md-4 text-center">
        <img src="@(Model.PosterUrl ?? "https://placehold.co/400x600?text=CiMYTict")"
             class="img-fluid rounded shadow" alt="@Model.Title" />
    </div>
    <div class="col-md-8">
        <span class="badge bg-danger mb-2">@Model.AgeRating</span>
        <span class="badge bg-secondary mb-2">@Model.Genre</span>
        <h2 class="fw-bold">@Model.Title</h2>
        <p class="text-muted"><i class="bi bi-clock me-1"></i>@Model.DurationMinutes Minutes &bull; Released @Model.ReleaseDate.ToString("dd MMM yyyy")</p>
        <p class="lead fs-6">@Model.Description</p>

        @if (!string.IsNullOrWhiteSpace(Model.TrailerUrl))
        {
            <div class="ratio ratio-16x9 mb-4 rounded overflow-hidden shadow-sm" style="max-width: 560px;">
                <iframe src="@Model.TrailerUrl" title="Trailer" allowfullscreen></iframe>
            </div>
        }

        <h4 class="fw-bold border-bottom pb-2 mb-3">Select Showtime</h4>
        @if (!Model.Showtimes.Any())
        {
            <div class="alert alert-warning">No upcoming showtimes available for this movie yet.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var st in Model.Showtimes.OrderBy(s => s.StartTime))
                {
                    <div class="col-sm-6 col-lg-4">
                        <div class="border rounded p-3 bg-light h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="fw-bold text-danger">@st.StartTime.ToString("ddd, dd MMM yyyy")</div>
                                <div class="fs-5 fw-bold">@st.StartTime.ToString("hh:mm tt")</div>
                                <div class="small text-muted">@st.CinemaHall?.HallName</div>
                                <div class="small fw-semibold mt-1">From RM @st.BaseTicketPrice.ToString("F2")</div>
                            </div>
                            <a asp-controller="Booking" asp-action="SelectSeats" asp-route-showtimeId="@st.ShowtimeId"
                               class="btn btn-dark btn-sm w-100 mt-3">
                                Choose Seats
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
